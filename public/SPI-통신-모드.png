        <div x-persist="toast">
    <div class="leading-0">
        <ui-toast x-data x-on:toast-show.document="$el.showToast($event.detail)" wire:ignore>
    <template>
        <div
            popover="manual"
            class="m-0 bg-transparent p-6 [&amp;[data-position*=bottom]]:mt-auto [&amp;[data-position*=bottom]]:mb-8 [&amp;[data-position*=top]]:mb-auto [&amp;[data-position*=right]]:ml-auto rtl:[&amp;[data-position*=right]]:mr-auto rtl:[&amp;[data-position*=right]]:ml-0 [&amp;[data-position*=left]]:mr-auto rtl:[&amp;[data-position*=left]]:mr-0 rtl:[&amp;[data-position*=left]]:ml-auto [&amp;[data-position*=center]]:mx-auto [&amp;[data-variant*=plain]_[data-close-button]]:hidden"
            data-position="bottom center"
            data-variant=""
            data-flux-toast-dialog
        >
            <div class="max-w-115 rounded-md bg-gray-secondary-dark-600 px-9.25 py-2.75">
                <div class="flex items-start gap-4">
                    <div
                        class="flex flex-1 gap-2 py-1.5 ps-2.5 [[data-flux-toast-dialog][data-variant*=plain]_&]:ps-0!"
                    >
                        
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 16 16"
                            fill="currentColor"
                            class="mt-0.5 hidden size-4 shrink-0 text-lime-600 dark:text-lime-400 [[data-flux-toast-dialog][data-variant=success]_&]:block"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm3.844-8.791a.75.75 0 0 0-1.188-.918l-3.7 4.79-1.649-1.833a.75.75 0 1 0-1.114 1.004l2.25 2.5a.75.75 0 0 0 1.15-.043l4.25-5.5Z"
                                clip-rule="evenodd"
                            />
                        </svg>

                        
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 16 16"
                            fill="currentColor"
                            class="mt-0.5 hidden size-4 shrink-0 text-amber-500 dark:text-amber-400 [[data-flux-toast-dialog][data-variant=warning]_&]:block"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M6.701 2.25c.577-1 2.02-1 2.598 0l5.196 9a1.5 1.5 0 0 1-1.299 2.25H2.804a1.5 1.5 0 0 1-1.3-2.25l5.197-9ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 1 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                                clip-rule="evenodd"
                            />
                        </svg>

                        
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 16 16"
                            fill="currentColor"
                            class="mt-0.5 hidden size-4 shrink-0 text-rose-500 dark:text-rose-400 [[data-flux-toast-dialog][data-variant=danger]_&]:block"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                                clip-rule="evenodd"
                            />
                        </svg>

                        <div>
                            

                            
                            <div class="text-gray-primary-dark-200 [&:not(:empty)+div]:text-gray-primary-dark-200 text-sm font-medium [&:not(:empty)]:pb-2 [&:not(:empty)+div]:font-normal"><slot name="heading"></slot></div>
                            

                            
                            <div class="text-center text-sm/[20px] text-gray-primary-dark-200">
                                <slot name="text"></slot>
                            </div>
                        </div>
                    </div>

                    
                    <div class="flex items-center" data-close-button>
                        <button
                            type="button"
                            onclick="this.closest('ui-toast').hideToast()"
                            class="inline-flex h-8 w-8 items-center justify-center gap-2 truncate rounded-md bg-transparent text-sm font-medium text-zinc-400 hover:bg-zinc-800/5 hover:text-gray-primary-dark-200 disabled:cursor-default disabled:opacity-50 dark:text-zinc-400 dark:hover:bg-white/15 dark:hover:text-white dark:disabled:opacity-75"
                            as="button"
                        >
                            <div>
                                <svg
                                    class="[:where(&)]:size-5"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 20 20"
                                    fill="currentColor"
                                    aria-hidden="true"
                                    data-slot="icon"
                                >
                                    <path
                                        d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"
                                    ></path>
                                </svg>
                            </div>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>
</ui-toast>
    </div>
</div>


        
        <div x-data="cookieConsent()">
    <section
        x-show="showBanner && !showPreferences"
        x-cloak
        class="fixed bottom-4 left-4 w-full max-w-xl tablet:bottom-8 tablet:left-8"
        role="dialog"
        aria-modal="true"
        x-on:open-cookies-preference.window="
            openPreferences()
            $flux.modal('cookie-preferences').show()
        "
    >
        <div class="[:where(&amp;)]:bg-white dark:[:where(&amp;)]:bg-white/10 border border-zinc-200 dark:border-white/10 [:where(&amp;)]:p-6 [:where(&amp;)]:rounded-xl rounded border-0 bg-white! p-6 shadow-[-5px_5px_10px_0px_#00000012,_0px_0px_50px_0px_#0000001a]" data-flux-card>
    <p class="text-sm leading-relaxed text-gray-secondary-dark-900">
                We use cookies to ensure the proper functioning of our site, to remember your preferences (such as global messages and release notes), and to analyze traffic. You can change your preferences at any time.

                <a class="inline font-medium underline-offset-[6px] hover:decoration-current underline [[data-color]&gt;&amp;]:text-inherit [[data-color]&gt;&amp;]:decoration-current/20 dark:[[data-color]&gt;&amp;]:decoration-current/50 [[data-color]&gt;&amp;]:hover:decoration-current text-[var(--color-accent-content)] decoration-[color-mix(in_oklab,var(--color-accent-content),transparent_80%)]" href="https://samsungtizenos.com/privacy-policy" target="_blank" rel="noopener" data-flux-link >Read our cookie &amp; privacy policy</a>            </p>

            <div class="mt-4 flex items-center justify-between gap-3">
                <div class="flex gap-3">
                    <button type="button" class="relative items-center justify-center font-bold whitespace-nowrap gap-2 disabled:pointer-events-none disabled:cursor-default text-sm h-10 px-6 rounded-[5rem] inline-flex  bg-samsung hover:bg-royal-dark text-gray-secondary-light-50 hover:text-white disabled:bg-gray-primary-light-400 disabled:text-gray-primary-light-100   [:is([data-flux-button-group]&gt;&amp;:last-child,_[data-flux-button-group]_:last-child&gt;&amp;)]:border-e-[1px] dark:[:is([data-flux-button-group]&gt;&amp;:last-child,_[data-flux-button-group]_:last-child&gt;&amp;)]:border-s-[1px] dark:[:is([data-flux-button-group]&gt;&amp;:last-child,_[data-flux-button-group]_:last-child&gt;&amp;)]:border-e-0 [:is([data-flux-button-group]&gt;&amp;:not(:first-child),_[data-flux-button-group]_:not(:first-child)&gt;&amp;)]:border-s-[color-mix(in_srgb,var(--color-accent-foreground),transparent_85%)] [[data-flux-button-group]_&amp;]:border-e-0   transition duration-200 ease-in-out cursor-pointer" data-flux-button="data-flux-button" data-flux-group-target="data-flux-group-target" x-on:click="acceptAll">
