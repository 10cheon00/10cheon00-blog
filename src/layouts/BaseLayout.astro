---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

const {
  title = '10cheon00의 Archive',
  description = '배운 내용을 정리하는 개인 기술 블로그입니다.'
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">10cheon00의 Archive</a>
        <nav aria-label="주요 메뉴">
          <a href="/blog/">글</a>
          <a href="/tags/">태그</a>
          <a href="/category/">분류</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: var(--text);
    font-weight: 750;
    letter-spacing: 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.95rem;
  }

  nav a {
    color: var(--muted);
  }

  @media (max-width: 620px) {
    .header-inner {
      align-items: flex-start;
      flex-direction: column;
      padding: 0.9rem 0;
    }
  }
</style>
