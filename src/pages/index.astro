---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getAllCategories, getAllTags, getCategory, getPublishedPosts } from '@/lib/posts';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 12);
const tags = getAllTags(posts);
const categories = getAllCategories(posts).map((name) => ({
  name,
  count: posts.filter((post) => getCategory(post) === name).length
}));
---

<BaseLayout>
  <section class="intro">
    <div class="container">
      <p class="eyebrow">Personal Technical Notes</p>
      <h1>스스로 배운 것을 정리한 블로그</h1>
      <p class="summary">혼자 공부하며 부딪쳤던 어려움들을 정리한 글들을 담고 있습니다.</p>
    </div>
  </section>
  <section class="container page-grid content">
    <div>
      <h2>최근 글</h2>
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
    <Sidebar tags={tags} categories={categories} />
  </section>
</BaseLayout>

<style>
  .intro {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 0.6rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  h1 {
    max-width: 100%;
    margin: 0;
    font-size: clamp(1.15rem, 5vw, 4.8rem);
    line-height: 1.08;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .summary {
    max-width: 720px;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .content {
    padding: 2rem 0 4rem;
  }

  h2 {
    margin: 0;
    font-size: 1.35rem;
  }
</style>
