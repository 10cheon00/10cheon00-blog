---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagChip from '@/components/TagChip.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, getPostDate, getPostDescription, getPostTitle, getPostUrl } from '@/lib/posts';
import { withBase } from '@/lib/urls';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\/index$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const title = getPostTitle(post);
const seriesPosts = post.data.series
  ? (await getCollection('blog', ({ data }) => !data.draft && data.series?.name === post.data.series?.name))
      .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
  : [];
const currentSeriesIndex = seriesPosts.findIndex((seriesPost) => seriesPost.id === post.id);
---

<BaseLayout title={`${title} | 10cheon00의 Archive`} description={getPostDescription(post)}>
  <article class="container article-grid">
    <header class="article-header">
      <a href={withBase('blog/')}>글 목록</a>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={getPostDate(post).toISOString()}>{formatDate(getPostDate(post))}</time>
        {post.data.tags?.map((tag) => <TagChip tag={tag} />)}
      </div>
    </header>
    <div class="article-body">
      {
        post.data.series ? (
          <section class="series" aria-labelledby="series-title">
            <div class="series-header">
              <h2 id="series-title">{post.data.series.name} 시리즈</h2>
              <div class="series-controls">
                <span>{currentSeriesIndex + 1} / {seriesPosts.length}</span>
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls="series-list"
                  aria-label="시리즈 목록 펼치기"
                  data-series-toggle
                >
                  <span class="toggle-icon" aria-hidden="true">⌃</span>
                </button>
              </div>
            </div>
            <ol id="series-list" class="series-list" data-series-list hidden>
              {seriesPosts.map((seriesPost) => {
                const isCurrent = seriesPost.id === post.id;
                return (
                  <li class:list={{ current: isCurrent }}>
                    <a href={getPostUrl(seriesPost)} aria-current={isCurrent ? 'page' : undefined}>
                      <span class="series-order">{(seriesPost.data.series?.order ?? 0) + 1}</span>
                      <span>{getPostTitle(seriesPost)}</span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ) : null
      }
      <Content />
    </div>
    {
      headings.length ? (
        <nav class="toc" aria-label="목차">
          <strong>목차</strong>
          {headings.filter((heading) => heading.depth <= 3).map((heading) => (
            <a class={`depth-${heading.depth}`} href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
          ))}
        </nav>
      ) : null
    }
  </article>
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) 240px;
    gap: 2rem;
    padding: 2.5rem 0 5rem;
  }

  .article-header {
    grid-column: 1 / -1;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .article-body {
    grid-column: 1;
  }

  .series {
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel);
  }

  .series-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .series-header:has(+ .series-list[hidden]) {
    border-bottom-color: transparent;
  }

  .series-header h2 {
    margin: 0;
    font-size: 1.05rem;
  }

  .series-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .series-controls > span {
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .series-controls button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--accent-strong);
    background: transparent;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }

  .series-controls button:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }

  .series-controls button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .toggle-icon {
    transition: transform 0.15s ease;
  }

  .series-controls button[aria-expanded="false"] .toggle-icon {
    transform: rotate(180deg);
  }

  .series ol {
    max-height: 21rem;
    margin: 0;
    padding: 0.45rem 0;
    overflow-y: auto;
    list-style: none;
  }

  .series li a {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.42rem 1rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .series li a:hover {
    color: var(--accent-strong);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    text-decoration: none;
  }

  .series li.current a {
    color: var(--accent-strong);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    font-weight: 700;
  }

  .series-order {
    min-width: 1.6rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .article-header h1 {
    max-width: 100%;
    margin: 0.55rem 0 0;
    font-size: clamp(1.15rem, 4vw, 3.5rem);
    line-height: 1.14;
    overflow-wrap: anywhere;
    word-break: keep-all;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.8rem;
    margin-top: 0.9rem;
    color: var(--muted);
  }

  .article-body {
    min-width: 0;
    font-size: 1.02rem;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 92px;
  }

  .toc {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    align-self: start;
    gap: 0.35rem;
    max-height: calc(100vh - 120px);
    overflow: auto;
    padding-left: 1rem;
    border-left: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .toc strong {
    margin-bottom: 0.2rem;
    color: var(--text);
  }

  .toc a {
    margin-left: -1rem;
    padding: 0.22rem 0.45rem 0.22rem 0.9rem;
    border-left: 3px solid transparent;
    border-radius: 0 5px 5px 0;
    color: var(--muted);
    line-height: 1.45;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .toc a[aria-current="location"] {
    border-left-color: var(--accent);
    color: var(--accent-strong);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    font-weight: 700;
    text-decoration: none;
  }

  .toc .depth-3 {
    padding-left: 1.7rem;
  }

  @media (max-width: 980px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .toc {
      display: none;
    }
  }
</style>

<script>
  const seriesToggle = document.querySelector<HTMLButtonElement>('[data-series-toggle]');
  const seriesList = document.querySelector<HTMLOListElement>('[data-series-list]');

  seriesToggle?.addEventListener('click', () => {
    if (!seriesList) return;

    const isExpanded = seriesToggle.getAttribute('aria-expanded') === 'true';
    seriesToggle.setAttribute('aria-expanded', String(!isExpanded));
    seriesToggle.setAttribute('aria-label', isExpanded ? '시리즈 목록 펼치기' : '시리즈 목록 숨기기');
    seriesList.hidden = isExpanded;
  });

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const sections = tocLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((section): section is HTMLElement => section !== null);

  function highlightCurrentSection() {
    if (!sections.length) return;

    const readingLine = 112;
    let currentSection = sections[0];

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= readingLine) currentSection = section;
      else break;
    }

    for (const link of tocLinks) {
      const isCurrent = decodeURIComponent(link.hash.slice(1)) === currentSection.id;
      if (isCurrent) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }

  let frameId = 0;
  function scheduleHighlight() {
    cancelAnimationFrame(frameId);
    frameId = requestAnimationFrame(highlightCurrentSection);
  }

  highlightCurrentSection();
  document.addEventListener('scroll', scheduleHighlight, { passive: true });
  window.addEventListener('resize', scheduleHighlight);
</script>
